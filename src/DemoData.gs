  var purchases = P.map(function (r, i) {
    var cycle = r[5];
    return { '구매ID': 'P' + pad_(i + 1, 4), '구매일': d(r[1]), '고객ID': r[0], '고객명': '', '제품/서비스': r[2], '특징/사양': r[3],
      '금액': r[4], '재구매주기(일)': cycle || '', '다음구매예정일': cycle ? d(r[1] + cycle) : '',
      '계약만료일/납기일': r[6] === null ? '' : d(r[6]), '수금예정일': r[7] === null ? '' : d(r[7]), '수금상태': r[8],
      '구매당시의향': r[9], '고민포인트': r[10], '다음제안': r[11], '메모': '' };
  });

  // 고객명 채우기 + 마지막연락일 = max(상담일, 구매일)
  var byId = indexBy_(customers, '고객ID');
  contacts.forEach(function (c) { c['고객명'] = byId[c['고객ID']]['고객명']; });
  purchases.forEach(function (p) { p['고객명'] = byId[p['고객ID']]['고객명']; });
  customers.forEach(function (c) { c['마지막연락일'] = computeLastContact(c['고객ID'], contacts, purchases, ''); });

  return { customers: customers, contacts: contacts, purchases: purchases };
}

/** 고객 1명의 마지막연락일 = max(현재값, 상담일들, 구매일들) → 'YYYY-MM-DD' 또는 '' */
function computeLastContact(customerId, contacts, purchases, current) {
  var best = toDate(current);
  function consider(v) { var x = toDate(v); if (x && (!best || daysBetween(best, x) > 0)) best = x; }
  (contacts || []).forEach(function (c) { if (String(c['고객ID']) === String(customerId)) consider(c['상담일']); });
  (purchases || []).forEach(function (p) { if (String(p['고객ID']) === String(customerId)) consider(p['구매일']); });
  return best ? fmtDate(best) : '';
}

function pad_(n, w) { var s = String(n); while (s.length < w) s = '0' + s; return s; }

/** DEFAULT_RULES 배열 → 규칙 객체 배열 (엔진 입력용) */
function defaultRuleObjects() {
  return DEFAULT_RULES.map(function (r) {
    var o = {};
    HEADERS['알림규칙'].forEach(function (h, i) { o[h] = r[i]; });
    return o;
  });
}
